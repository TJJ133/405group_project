args <- commandArgs(trailingOnly = TRUE)
year <- args[1]

# Construct file paths
torn_file <- paste0("extracted_torn_data/", year, "_tornado.csv")
hail_file <- paste0("extracted_hail_data/", year, "_hail.csv")
wind_file <- paste0("extracted_wind_data/", year, "_wind.csv")

# Read and tag data
torn <- if (file.exists(torn_file)) read.csv(torn_file) else data.frame(st = character(), loss = numeric())
hail <- if (file.exists(hail_file)) read.csv(hail_file) else data.frame(st = character(), loss = numeric())
wind <- if (file.exists(wind_file)) read.csv(wind_file) else data.frame(st = character(), loss = numeric())

torn$type <- "Tornado"
hail$type <- "Hail"
wind$type <- "Wind"

# Combine
all_data <- rbind(torn[, c("st", "loss", "type")],
                  hail[, c("st", "loss", "type")],
                  wind[, c("st", "loss", "type")])

# Summarize
library(dplyr)
summary <- all_data %>%
  group_by(st, type) %>%
  summarise(total_loss = sum(loss, na.rm = TRUE), .groups = "drop") %>%
  tidyr::pivot_wider(names_from = type, values_from = total_loss, values_fill = 0)

# Save
output_file <- paste0("loss_summary_", year, ".csv")
write.csv(summary, output_file, row.names = FALSE)
