universe              = vanilla
executable            = /usr/bin/env
arguments             = Rscript calc_loss_by_year.R $(YEAR)

container_image       = file:///staging/jgillett/R_tidyverse_FITSio.sif

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Transfer the script and required yearly CSVs
transfer_input_files  = calc_loss_by_year.R, \
                         extracted_torn_data, \
                         extracted_hail_data, \
                         extracted_wind_data

# Make sure logs exist
output                = logs/loss_$(YEAR).out
error                 = logs/loss_$(YEAR).err
log                   = logs/loss_$(YEAR).log

# Return just the summary output
transfer_output_files = loss_summary_$(YEAR).csv

request_cpus          = 1
request_memory        = 512MB
request_disk          = 500MB

queue YEAR from (
1996
1997
1998
1999
2000
2001
2002
2003
2004
2005
2006
2007
2008
2009
2010
2011
2012
2013
2014
2015
2016
2017
2018
2019
2020
2021
2022
2023
)
